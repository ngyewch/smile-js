{
  "name": "smile-js",
  "version": "0.10.1",
  "type": "module",
  "description": "Javascript Smile implementation.",
  "author": "Nick Ng",
  "license": "Apache-2.0",
  "homepage": "http://ngyewch.github.io/smile-js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngyewch/smile-js.git"
  },
  "bugs": {
    "url": "https://github.com/ngyewch/smile-js/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/smile-js.js",
      "require": "./dist/smile-js.cjs"
    }
  },
  "module": "./dist/smile-js.js",
  "main": "./dist/smile-js.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "smile-cli": "./bin/smile-cli"
  },
  "scripts": {
    "doBuild": "vite build",
    "doBuildCli": "vite build --config vite.config.cli.ts",
    "check": "tsc --noEmit && tsc-strict",
    "build": "run-s check doBuild doBuildCli",
    "test": "tap",
    "typedoc": "typedoc",
    "postbuild": "validate-package-exports --check",
    "prepublishOnly": "validate-package-exports --check",
    "knip": "knip"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@tapjs/core": "4.6.0",
    "@types/node": "24.19.2",
    "commander": "15.0.0",
    "dependency-cruiser": "18.7.0",
    "gh-pages": "6.3.0",
    "glob": "14.0.3",
    "js-base64": "3.9.5",
    "js-testdiff": "1.0.5",
    "knip": "6.44.1",
    "lossless-json": "4.3.3",
    "npm-run-all2": "9.0.4",
    "tap": "21.8.0",
    "typedoc": "0.28.20",
    "typescript": "5.6.3",
    "typescript-strict-plugin": "2.4.4",
    "validate-package-exports": "1.6.0",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2"
  },
  "dependencies": {
    "bit-buffer": "0.3.0"
  },
  "keywords": [
    "smile"
  ],
  "files": [
    "bin/*",
    "dist/*"
  ]
}
